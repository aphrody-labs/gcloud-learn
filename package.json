{
  "name": "gcloud-learn-monorepo",
  "version": "2026.11.0",
  "private": true,
  "description": "Google Cloud & Sovereign Engineering Monorepo (Upstream Bun, Pure TS, WebGPU 3D, Chromium/AOSP Tree)",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run --cwd apps/api dev",
    "build": "bun run --cwd apps/api build",
    "check": "bun check",
    "lint": "bun lint",
    "test": "bun test",
    "fmt": "bun fmt",
    "fmt:check": "bun fmt --check"
  },
  "trustedDependencies": [
    "@types/bun"
  ],
  "devDependencies": {
    "@types/bun": "^1.2.4"
  }
}
